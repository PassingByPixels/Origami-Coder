{
  "name": "Origami Custom",
  "type": "dark",
  "colors": {
    "editor.background": "#0e1411",
    "editor.foreground": "#e7efe9",
    "editorLineNumber.foreground": "#6f8678",
    "editorLineNumber.activeForeground": "#5fa382",
    "editor.selectionBackground": "#1f2c24",
    "editor.lineHighlightBackground": "#131c18",
    "editorCursor.foreground": "#5fa382",
    "editorGutter.background": "#0e1411",
    "editorWidget.background": "#16201b",
    "editorWidget.border": "#2a3a31",
    "editorSuggestWidget.background": "#16201b",
    "editorSuggestWidget.border": "#2a3a31",
    "editorSuggestWidget.selectedBackground": "#1f2c24",
    "sideBar.background": "#131c18",
    "sideBar.foreground": "#e7efe9",
    "sideBarTitle.foreground": "#e7efe9",
    "sideBarSectionHeader.background": "#16201b",
    "sideBarSectionHeader.foreground": "#e7efe9",
    "activityBar.background": "#0e1411",
    "activityBar.foreground": "#e7efe9",
    "activityBar.inactiveForeground": "#6f8678",
    "activityBarBadge.background": "#5fa382",
    "activityBarBadge.foreground": "#0e1411",
    "statusBar.background": "#131c18",
    "statusBar.foreground": "#e7efe9",
    "statusBar.noFolderBackground": "#131c18",
    "titleBar.activeBackground": "#0e1411",
    "titleBar.activeForeground": "#e7efe9",
    "titleBar.inactiveBackground": "#0e1411",
    "titleBar.inactiveForeground": "#9fb3a7",
    "tab.activeBackground": "#16201b",
    "tab.activeForeground": "#e7efe9",
    "tab.inactiveBackground": "#0e1411",
    "tab.inactiveForeground": "#9fb3a7",
    "tab.border": "#131c18",
    "tab.activeBorderTop": "#5fa382",
    "editorGroupHeader.tabsBackground": "#131c18",
    "panel.background": "#131c18",
    "panel.border": "#2a3a31",
    "panelTitle.activeForeground": "#5fa382",
    "panelTitle.inactiveForeground": "#9fb3a7",
    "terminal.background": "#0e1411",
    "terminal.foreground": "#e7efe9",
    "input.background": "#1b271f",
    "input.foreground": "#e7efe9",
    "input.border": "#2a3a31",
    "focusBorder": "#5fa382",
    "button.background": "#5fa382",
    "button.foreground": "#0e1411",
    "button.hoverBackground": "#6cbf97",
    "list.activeSelectionBackground": "#1f2c24",
    "list.activeSelectionForeground": "#e7efe9",
    "list.hoverBackground": "#16201b",
    "list.inactiveSelectionBackground": "#16201b",
    "scrollbarSlider.background": "#2a3a3180",
    "scrollbarSlider.hoverBackground": "#3f7268",
    "scrollbarSlider.activeBackground": "#5fa382",
    "badge.background": "#5fa382",
    "badge.foreground": "#0e1411",
    "foreground": "#e7efe9"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6f8678", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#9ecbb4" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#d9b15a" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#d9776a", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#6ea0d0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#d9b15a" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#e7efe9" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#d9b15a", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#d9776a", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#9ecbb4" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#9fb3a7", "fontStyle": "italic" } }
  ]
}
