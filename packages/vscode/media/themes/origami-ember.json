{
  "name": "Origami Ember",
  "type": "light",
  "colors": {
    "editor.background": "#d4bc9a",
    "editor.foreground": "#37342f",
    "editorLineNumber.foreground": "#8a7d66",
    "editorLineNumber.activeForeground": "#a85a32",
    "editor.selectionBackground": "#b79e7b",
    "editor.lineHighlightBackground": "#c7ad85",
    "editorCursor.foreground": "#a85a32",
    "editorGutter.background": "#c7ad85",
    "editorWidget.background": "#c7ad85",
    "editorWidget.border": "#9a6642",
    "editorSuggestWidget.background": "#c7ad85",
    "editorSuggestWidget.border": "#9a6642",
    "editorSuggestWidget.selectedBackground": "#b79e7b",
    "sideBar.background": "#c7ad85",
    "sideBar.foreground": "#37342f",
    "sideBarTitle.foreground": "#37342f",
    "sideBarSectionHeader.background": "#b79e7b",
    "sideBarSectionHeader.foreground": "#37342f",
    "activityBar.background": "#b79e7b",
    "activityBar.foreground": "#37342f",
    "activityBar.inactiveForeground": "#8a7d66",
    "activityBarBadge.background": "#a85a32",
    "activityBarBadge.foreground": "#f0e8dc",
    "statusBar.background": "#9a6642",
    "statusBar.foreground": "#f0e8dc",
    "statusBar.noFolderBackground": "#9a6642",
    "titleBar.activeBackground": "#b79e7b",
    "titleBar.activeForeground": "#37342f",
    "titleBar.inactiveBackground": "#b79e7b",
    "titleBar.inactiveForeground": "#8a7d66",
    "tab.activeBackground": "#d4bc9a",
    "tab.activeForeground": "#a85a32",
    "tab.inactiveBackground": "#b79e7b",
    "tab.inactiveForeground": "#8a7d66",
    "tab.border": "#9a6642",
    "tab.activeBorderTop": "#a85a32",
    "editorGroupHeader.tabsBackground": "#b79e7b",
    "panel.background": "#c7ad85",
    "panel.border": "#9a6642",
    "panelTitle.activeForeground": "#a85a32",
    "panelTitle.inactiveForeground": "#8a7d66",
    "terminal.background": "#d4bc9a",
    "terminal.foreground": "#37342f",
    "input.background": "#b79e7b",
    "input.foreground": "#37342f",
    "input.border": "#9a6642",
    "focusBorder": "#a85a32",
    "button.background": "#a85a32",
    "button.foreground": "#f0e8dc",
    "button.hoverBackground": "#8c4a28",
    "list.activeSelectionBackground": "#b79e7b",
    "list.activeSelectionForeground": "#37342f",
    "list.hoverBackground": "#c7ad85",
    "list.inactiveSelectionBackground": "#c7ad85",
    "scrollbarSlider.background": "#9a664266",
    "scrollbarSlider.hoverBackground": "#9a664299",
    "scrollbarSlider.activeBackground": "#a85a32",
    "badge.background": "#a85a32",
    "badge.foreground": "#f0e8dc",
    "foreground": "#37342f"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a7d66", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#5f4744" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#c2410c" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#a85a32", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#5f4744" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#9a6642" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#37342f" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#a85a32", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#a85a32", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#5f4744" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#8a7d66", "fontStyle": "italic" } }
  ]
}
