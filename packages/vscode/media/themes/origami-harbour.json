{
  "name": "Origami Harbour",
  "type": "dark",
  "colors": {
    "editor.background": "#0b1418",
    "editor.foreground": "#e6eef4",
    "editorLineNumber.foreground": "#6d8598",
    "editorLineNumber.activeForeground": "#5aa9d4",
    "editor.selectionBackground": "#1c3340",
    "editor.lineHighlightBackground": "#0f1c24",
    "editorCursor.foreground": "#5aa9d4",
    "editorGutter.background": "#0b1418",
    "editorWidget.background": "#12212a",
    "editorWidget.border": "#263a48",
    "editorSuggestWidget.background": "#12212a",
    "editorSuggestWidget.border": "#263a48",
    "editorSuggestWidget.selectedBackground": "#1c3340",
    "sideBar.background": "#0f1c24",
    "sideBar.foreground": "#e6eef4",
    "sideBarTitle.foreground": "#e6eef4",
    "sideBarSectionHeader.background": "#12212a",
    "sideBarSectionHeader.foreground": "#e6eef4",
    "activityBar.background": "#0b1418",
    "activityBar.foreground": "#e6eef4",
    "activityBar.inactiveForeground": "#6d8598",
    "activityBarBadge.background": "#5aa9d4",
    "activityBarBadge.foreground": "#0b1418",
    "statusBar.background": "#0f1c24",
    "statusBar.foreground": "#e6eef4",
    "statusBar.noFolderBackground": "#0f1c24",
    "titleBar.activeBackground": "#0b1418",
    "titleBar.activeForeground": "#e6eef4",
    "titleBar.inactiveBackground": "#0b1418",
    "titleBar.inactiveForeground": "#9fb4c4",
    "tab.activeBackground": "#12212a",
    "tab.activeForeground": "#e6eef4",
    "tab.inactiveBackground": "#0b1418",
    "tab.inactiveForeground": "#9fb4c4",
    "tab.border": "#0f1c24",
    "tab.activeBorderTop": "#5aa9d4",
    "editorGroupHeader.tabsBackground": "#0f1c24",
    "panel.background": "#0f1c24",
    "panel.border": "#263a48",
    "panelTitle.activeForeground": "#5aa9d4",
    "panelTitle.inactiveForeground": "#9fb4c4",
    "terminal.background": "#0b1418",
    "terminal.foreground": "#e6eef4",
    "input.background": "#14232d",
    "input.foreground": "#e6eef4",
    "input.border": "#263a48",
    "focusBorder": "#5aa9d4",
    "button.background": "#5aa9d4",
    "button.foreground": "#0b1418",
    "button.hoverBackground": "#6fb8de",
    "list.activeSelectionBackground": "#1c3340",
    "list.activeSelectionForeground": "#e6eef4",
    "list.hoverBackground": "#12212a",
    "list.inactiveSelectionBackground": "#12212a",
    "scrollbarSlider.background": "#263a4880",
    "scrollbarSlider.hoverBackground": "#3f7e9a",
    "scrollbarSlider.activeBackground": "#5aa9d4",
    "badge.background": "#5aa9d4",
    "badge.foreground": "#0b1418",
    "foreground": "#e6eef4"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6d8598", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#9ecbe0" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#d9b15a" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#e0897a", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#6ea0d0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#d9b15a" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#e6eef4" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#d9b15a", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#e0897a", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#9ecbe0" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#9fb4c4", "fontStyle": "italic" } }
  ]
}
