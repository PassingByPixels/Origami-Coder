{
  "name": "Origami Midnight",
  "type": "dark",
  "colors": {
    "editor.background": "#07091a",
    "editor.foreground": "#c8c8e0",
    "editorLineNumber.foreground": "#6a6a8a",
    "editorLineNumber.activeForeground": "#a78bfa",
    "editor.selectionBackground": "#2a2648",
    "editor.lineHighlightBackground": "#0d0f22",
    "editorCursor.foreground": "#a78bfa",
    "editorGutter.background": "#090b1c",
    "editorWidget.background": "#0d0f22",
    "editorWidget.border": "#2a2648",
    "editorSuggestWidget.background": "#0d0f22",
    "editorSuggestWidget.border": "#2a2648",
    "editorSuggestWidget.selectedBackground": "#2a2648",
    "sideBar.background": "#090b1c",
    "sideBar.foreground": "#c8c8e0",
    "sideBarTitle.foreground": "#c8c8e0",
    "sideBarSectionHeader.background": "#0d0f22",
    "sideBarSectionHeader.foreground": "#c8c8e0",
    "activityBar.background": "#07091a",
    "activityBar.foreground": "#c8c8e0",
    "activityBar.inactiveForeground": "#6a6a8a",
    "activityBarBadge.background": "#7c3aed",
    "activityBarBadge.foreground": "#07091a",
    "statusBar.background": "#090b1c",
    "statusBar.foreground": "#c8c8e0",
    "statusBar.noFolderBackground": "#090b1c",
    "titleBar.activeBackground": "#07091a",
    "titleBar.activeForeground": "#c8c8e0",
    "titleBar.inactiveBackground": "#07091a",
    "titleBar.inactiveForeground": "#9090b8",
    "tab.activeBackground": "#0d0f22",
    "tab.activeForeground": "#c084fc",
    "tab.inactiveBackground": "#07091a",
    "tab.inactiveForeground": "#9090b8",
    "tab.border": "#090b1c",
    "tab.activeBorderTop": "#a78bfa",
    "editorGroupHeader.tabsBackground": "#090b1c",
    "panel.background": "#090b1c",
    "panel.border": "#2a2648",
    "panelTitle.activeForeground": "#a78bfa",
    "panelTitle.inactiveForeground": "#9090b8",
    "terminal.background": "#07091a",
    "terminal.foreground": "#c8c8e0",
    "input.background": "#0d0f22",
    "input.foreground": "#c8c8e0",
    "input.border": "#2a2648",
    "focusBorder": "#7c3aed",
    "button.background": "#7c3aed",
    "button.foreground": "#f4f0ff",
    "button.hoverBackground": "#9156f0",
    "list.activeSelectionBackground": "#2a2648",
    "list.activeSelectionForeground": "#c8c8e0",
    "list.hoverBackground": "#0d0f22",
    "list.inactiveSelectionBackground": "#0d0f22",
    "scrollbarSlider.background": "#7c3aed33",
    "scrollbarSlider.hoverBackground": "#7c3aed55",
    "scrollbarSlider.activeBackground": "#a78bfa",
    "badge.background": "#7c3aed",
    "badge.foreground": "#f4f0ff",
    "foreground": "#c8c8e0"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a6a8a", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a78bfa" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#c084fc" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#7c3aed", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#a78bfa" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#c084fc" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#c8c8e0" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#c084fc", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#7c3aed", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#a78bfa" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#9090b8", "fontStyle": "italic" } }
  ]
}
